type Pokemon {
    id: ID!
    name: String!
    types: [String!]!
    moves: [String!]!
}

type Query {
    findPokemonById(id: ID!): Pokemon
    findPokemonByName(name: String!): Pokemon

    findTrainerById(id: ID!): Trainer
    findTrainerByName(name: String!): Trainer
    me: Trainer

    findTeamById(id: ID!): Team
    findAllTeams: [Team!]!
}

type Mutation {
    registerTrainer(name: String!, email: String!, password: String!): Trainer
    loginTrainer(email: String!, password: String!): AuthPayload
    createTeam(trainerId: ID!, name: String!): Team

    addPokemonToTeam(pokemonId: ID!, teamId: ID!):Team
}

type AuthPayload {
    token: String!
    trainer: Trainer!
}

type Team{
    id: ID!
    name: String!
    pokemons: [Pokemon!]!
}

type Trainer {
    id: ID!
    name: String!
    email: String!
    password: String!
    team: Team
}
