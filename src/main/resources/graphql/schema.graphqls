type Query {
    findPokemonById(id: Int!): Pokemon
    findPokemonByName(name: String!): Pokemon

    findTrainerById(id: ID!): Trainer
    findTrainerByName(name: String!): Trainer

    me: Trainer

    findTeamById(id: ID!): Team
    findAllTeams: [Team!]!
}

type Mutation {
    createTeam(trainerId: ID!, name: String!): Team

    addPokemonToTeam(pokemonId: ID!, teamId: ID!):Team
    removePokemonOfTeam(pokemonId: ID!, teamId: ID!):Team

    updateProfile(id:ID!, input: UpdateProfileInput!): Trainer!
    changePassword(input: ChangePasswordInput!): Boolean!

    deleteMyTrainer: Boolean!
}

type Trainer {
    id: ID!
    name: String!
    email: String!
    password: String!
    team: Team
}

type Team{
    id: ID!
    name: String!
    pokemons: [Pokemon!]!
}

type Pokemon {
    id: Int!
    name: String!
    types: [String!]!
    moves: [String!]!
}

input UpdateProfileInput {
    name: String
    email: String
}

input ChangePasswordInput {
    currentPassword: String!
    newPassword: String!
}
